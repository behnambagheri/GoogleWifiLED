config monitor 'main'
    option enabled '1'
    # Zero follows Passwall2's node_socks_port, currently 1070 on Google WiFi.
    option socks_port '0'
    option interval '30'
    option connect_timeout '3'
    option request_timeout '8'
    option failure_threshold '2'
    option recovery_threshold '1'
    # HTTPS time to first byte, including connection setup; this is not ICMP ping.
    option slow_ms '1200'
    option brightness '64'
    list check_url 'https://www.google.com/generate_204'
    list check_url 'https://cp.cloudflare.com/generate_204'
