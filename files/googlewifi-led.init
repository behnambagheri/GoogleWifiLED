#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

extra_command "check" "Check configuration and proxy connectivity without changing LEDs"
extra_command "probe" "Request a fresh check from the running controller"

start_service() {
    local enabled
    config_load googlewifi_led
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    [ "$(uci -q get system.googlewifi_led.trigger)" = googlewifi ] || return 0
    [ "$(uci -q get system.@system[0].leds_off)" != 1 ] || return 0

    procd_open_instance
    procd_set_param command /usr/libexec/googlewifi-led run
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/googlewifi_led /etc/config/passwall2
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger googlewifi_led passwall2 system
}

reload_service() {
    stop
    start
}

check() {
    /usr/libexec/googlewifi-led check
}

probe() {
    procd_send_signal googlewifi-led instance1 USR1
}
